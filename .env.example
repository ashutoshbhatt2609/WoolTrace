# Core application. Use http://localhost:3000 for local Google OAuth.
APP_BASE_URL=https://your-wooltrace-domain.vercel.app
AUTH_SECRET=
DEMO_MODE=false

# Turso database and Google OAuth web application (server-only secrets)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional farm-weather location; not automatic user location
FARM_LATITUDE=14.2251
FARM_LONGITUDE=76.3980
FARM_LOCATION_NAME=Chitradurga, Karnataka

# Optional commercial Open-Meteo customer API key
OPEN_METEO_API_KEY=
# Enable only for eligible non-commercial evaluation instead of a paid key
WEATHER_NONCOMMERCIAL=false

# Optional server-only AI assistant. Choose an available model in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
